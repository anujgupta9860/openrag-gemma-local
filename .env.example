# Copy to .env and edit if you want non-defaults. .env is git-ignored.
# Every value has a working default in setup.sh, so copying is optional.

# OpenRAG upstream tag (langflow-ai/openrag) to pin.
OPENRAG_TAG=v0.3.0

# Chat model served by Ollama. MUST be a model Ollama flags as
# tool-capable — OpenRAG's onboarding validates tool calling and
# rejects models without it (gemma3 is NOT flagged, verified on
# Ollama 0.40.13). llama3.1:8b is the proven default; qwen2.5 / qwen3
# also qualify.
CHAT_MODEL=llama3.1:8b

# Embedding model served by Ollama. Changing this AFTER ingesting
# documents means re-ingesting everything (vectors are model-specific).
EMBED_MODEL=nomic-embed-text

# Where the OpenRAG backend container reaches the host's Ollama.
# Default works on Mac/Windows Docker Desktop.
# OLLAMA_ENDPOINT=http://host.docker.internal:11434

# UI port (only change if 3000 is taken).
# FRONTEND_PORT=3000
